NEXT_TELEMETRY_DISABLED=1

# App
NEXT_PUBLIC_APP_MODE=development
NEXT_PUBLIC_APP_NAME=project_frozen
NEXT_PUBLIC_APP_TZ=Asia/Bangkok
NEXT_PUBLIC_APP_URL=http://localhost:8190

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=db_frozen
DB_USER=postgres
DB_PASSWORD=password
DB_TZ=Asia/Bangkok

# Redis (job queue + live progress)
REDIS_URL=redis://[username]:[password]@[host]:[port]
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=password

# ComfyUI (the generation engine). Frozen keeps its files in a "frozen" subfolder of each directory.
COMFY_URL=http://127.0.0.1:8188
COMFY_INPUT_DIR=D:/Downloads/ComfyUI/input
COMFY_OUTPUT_DIR=D:/Downloads/ComfyUI/output

# Text to speech (optional; see README). The worker starts tts/server.py on this port for voice jobs.
# The paths are relative to the project root, and these are the defaults. The model folder is the one
# the form starts on; other folders beside it show up in the form's Model list.
TTS_PORT=8191
TTS_PYTHON=tts/.venv/Scripts/python.exe
TTS_MODEL_DIR=tts/models/japanese-parler-tts-mini

# Image captioning (optional; see README). The worker starts caption/server.py on this port for caption
# jobs. The model folder is the one the form starts on; any other vision-language model in a folder
# beside it shows up in the form's Model list.
CAPTION_PORT=8192
CAPTION_PYTHON=caption/.venv/Scripts/python.exe
CAPTION_MODEL_DIR=caption/models/Ministral-3-8B-Uncensored-FP8
