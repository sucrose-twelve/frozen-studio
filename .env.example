NEXT_TELEMETRY_DISABLED=1

# App
NEXT_PUBLIC_APP_MODE=development
NEXT_PUBLIC_APP_NAME=project_frozen
NEXT_PUBLIC_APP_TZ=Asia/Bangkok
NEXT_PUBLIC_APP_URL=http://localhost:8190

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=db_frozen
DB_USER=postgres
DB_PASSWORD=password
DB_TZ=Asia/Bangkok

# Redis (job queue + live progress)
REDIS_URL=redis://[username]:[password]@[host]:[port]
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=password

# ComfyUI (the generation engine). Frozen keeps its files in a "frozen" subfolder of each directory.
COMFY_URL=http://127.0.0.1:8188
COMFY_INPUT_DIR=D:/Downloads/ComfyUI/input
COMFY_OUTPUT_DIR=D:/Downloads/ComfyUI/output
